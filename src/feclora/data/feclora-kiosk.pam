# PAM session for the Feclora Weston kiosk.
# This is a systemd-managed service, not an interactive login. The kiosk
# account intentionally has a locked password, so do not authenticate it
# with pam_unix; grant the service session and let pam_systemd create its
# logind seat/runtime environment.
auth       required     pam_permit.so
account    required     pam_permit.so
session    required     pam_unix.so
session    required     pam_systemd.so
