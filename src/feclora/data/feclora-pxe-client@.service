[Unit]
Description=Feclora authenticated PXE Client deployment job %i
Requires=mnt-feclora\x2dpxe\x2didentity.mount
After=network-online.target run-feclora-pxe\x2didentity.mount
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/usr/share/feclora/python
Environment=FECLORA_CLIENT_CONFIG=/mnt/feclora-pxe-identity/feclora-client-identity/deployment-client.json
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /run/feclora
ExecStartPre=/usr/bin/install -d -o root -g root -m 0700 /var/lib/feclora/client-jobs
ExecStart=/usr/bin/python3 -m feclora.deployment.client_service --job-id %i
ExecStopPost=/usr/bin/python3 -m feclora.deployment.client_service --job-id %i --mark-interrupted
Restart=no
TimeoutStopSec=infinity
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/feclora /etc/feclora /run/feclora

[Install]
# Started only after a PXE job request has been safely prepared.
