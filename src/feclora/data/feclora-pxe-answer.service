[Unit]
Description=Fetch and validate the shared Feclora unattended restore answer
Wants=network-online.target NetworkManager-wait-online.service
After=network-online.target NetworkManager-wait-online.service

[Service]
Type=simple
RuntimeDirectory=feclora/pxe
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
User=root
Group=root
Environment=PYTHONPATH=/usr/share/feclora/python
ExecStart=/usr/bin/python3 -m feclora.network.pxe_answer_client
TimeoutStartSec=infinity
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/feclora/pxe

[Install]
WantedBy=multi-user.target
