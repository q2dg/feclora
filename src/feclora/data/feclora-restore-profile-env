#!/usr/bin/env bash
set -Eeuo pipefail

: "${FECLORA_PROFILE:?FECLORA_PROFILE is required}"
: "${FECLORA_PROFILE_TRUSTED_KEY:?FECLORA_PROFILE_TRUSTED_KEY is required}"
: "${FECLORA_IMAGE_TRUSTED_KEY:?FECLORA_IMAGE_TRUSTED_KEY is required}"
: "${FECLORA_IMAGE_REPOSITORY:?FECLORA_IMAGE_REPOSITORY is required}"
: "${FECLORA_CONSUMPTION_LEDGER:?FECLORA_CONSUMPTION_LEDGER is required}"
: "${FECLORA_OPERATION_LOG:?FECLORA_OPERATION_LOG is required}"

args=(
  --profile "$FECLORA_PROFILE"
  --profile-trusted-key "$FECLORA_PROFILE_TRUSTED_KEY"
  --image-trusted-key "$FECLORA_IMAGE_TRUSTED_KEY"
  --repository "$FECLORA_IMAGE_REPOSITORY"
  --consumption-ledger "$FECLORA_CONSUMPTION_LEDGER"
  --operation-log "$FECLORA_OPERATION_LOG"
)
if [[ -n "${FECLORA_AGE_IDENTITY:-}" ]]; then
  args+=(--age-identity "$FECLORA_AGE_IDENTITY")
fi

exec /usr/local/bin/feclora-restore-profile "${args[@]}"
