#!/usr/bin/bash
# Temporary diagnostic aid: show the guest IPv4 address on tty1 before Cage
# takes over the display. This is intentionally enabled only in diagnostic ISOs.
set -u

TTY=/dev/tty1
[[ -c "$TTY" ]] || exit 0

addresses=""
for attempt in $(seq 1 30); do
  addresses="$(/usr/sbin/ip -4 -o address show scope global 2>/dev/null | /usr/bin/awk '{ split($4, a, "/"); printf "  %-12s %s\n", $2, a[1] }')"
  [[ -n "$addresses" ]] && break
  sleep 2
done

{
  printf '\033[H\033[2J'
  printf '\n  FECLORA - ACCES SSH DE DIAGNOSTIC\n\n'
  if [[ -n "$addresses" ]]; then
    printf '  Adreca IP de la maquina virtual:\n%s\n' "$addresses"
    printf '\n  Connecta des de l'amfitrio amb:\n'
    printf '  ssh pepe@ADRECA_IP\n'
  else
    printf '  Encara no s'ha obtingut cap adreca IPv4 per DHCP.\n'
    printf '  Comprova la configuracio de xarxa de VirtualBox.\n'
  fi
  printf '\n  Aquest missatge romandra visible durant 25 segons.\n\n'
} > "$TTY"

sleep 25
exit 0
