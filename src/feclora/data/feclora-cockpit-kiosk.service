[Unit]
Description=Feclora local Cockpit kiosk session without login
After=local-fs.target
Before=feclora-kiosk.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/cockpit-ws --address 127.0.0.1 --port 9091 --local-session /usr/libexec/cockpit-bridge
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
