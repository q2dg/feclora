[Unit]
Description=Feclora GTK4 Wayland kiosk on tty1
After=dbus.socket systemd-logind.service systemd-user-sessions.service feclora-local-operation-recovery.service getty@tty1.service
Wants=dbus.socket systemd-logind.service
Requires=feclora-local-operation-recovery.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=feclora
Group=feclora
PAMName=login
Environment=HOME=/home/feclora
Environment=PYTHONPATH=/usr/share/feclora/python
Environment=GDK_BACKEND=wayland
Environment=XDG_SESSION_TYPE=wayland
RuntimeDirectory=feclora-gtk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=+/usr/bin/chvt 1
ExecStartPre=+/usr/bin/echo Starting Feclora GTK4 Wayland kiosk
ExecStart=/usr/bin/cage -x -s -- /usr/bin/python3 -m feclora.gui_gtk
ExecStartPost=+/usr/libexec/feclora/feclora-gtk-ready
Restart=always
RestartSec=2
UMask=0077
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
