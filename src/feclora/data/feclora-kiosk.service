[Unit]
Description=Feclora Firefox kiosk on the local display
StartLimitIntervalSec=0
Wants=dbus.socket systemd-logind.service plymouth-start.service
After=dbus.socket systemd-logind.service systemd-user-sessions.service plymouth-start.service
Before=plymouth-quit.service
ConditionPathExists=/dev/tty0
Conflicts=getty@tty1.service
Wants=feclora-cockpit-kiosk.service

[Service]
Type=simple
User=feclora-kiosk
Group=feclora-kiosk
SupplementaryGroups=video render
Environment=HOME=/var/lib/feclora-kiosk
Environment=XDG_RUNTIME_DIR=/run/feclora-kiosk
Environment=MOZ_ENABLE_WAYLAND=1
EnvironmentFile=-/etc/feclora/kiosk-keyboard.conf
PAMName=feclora-kiosk
RuntimeDirectory=feclora-kiosk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty-fail
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
UtmpIdentifier=tty1
UtmpMode=user
SyslogIdentifier=feclora-kiosk
StandardOutput=journal
StandardError=journal
ExecStart=/usr/libexec/feclora/feclora-kiosk-launch
# Activate the service's assigned VT after PAM/logind registers the session,
# but before Weston asks logind for an active DRM session. Delaying chvt until
# the Wayland socket exists deadlocks: Weston cannot create it before activation.
ExecStartPre=+/usr/bin/chvt 1
ExecStartPre=+/usr/libexec/feclora/feclora-kiosk-display preflight
ExecStartPost=+/usr/libexec/feclora/feclora-kiosk-display handoff
ExecStopPost=+/usr/libexec/feclora/feclora-kiosk-diagnostics stop
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=::1/128
ReadWritePaths=/var/lib/feclora-kiosk /var/log/feclora-kiosk

[Install]
WantedBy=graphical.target
