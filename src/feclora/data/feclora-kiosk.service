[Unit]
Description=Feclora Firefox kiosk on the local display
StartLimitIntervalSec=0
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service systemd-user-sessions.service plymouth-quit-wait.service feclora-cockpit-kiosk.service
Before=graphical.target
ConditionPathExists=/dev/tty0
Conflicts=getty@tty1.service
Requires=feclora-cockpit-kiosk.service

[Service]
Type=simple
User=feclora-kiosk
Group=feclora-kiosk
SupplementaryGroups=video render
Environment=HOME=/var/lib/feclora-kiosk
Environment=MOZ_ENABLE_WAYLAND=1
Environment=LIBSEAT_BACKEND=logind
EnvironmentFile=-/etc/feclora/kiosk-keyboard.conf
PAMName=feclora-kiosk
TTYPath=/dev/tty1
StandardInput=tty-fail
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
UtmpIdentifier=tty1
UtmpMode=user
SyslogIdentifier=feclora-kiosk
StandardOutput=journal
StandardError=journal
ExecStart=/usr/libexec/feclora/feclora-kiosk-launch
# Do not switch to tty1 while Cage is still initializing: that exposes a
# blank VT if DRM/logind acquisition has not completed yet.
ExecStartPost=+/usr/bin/bash -c 'uid="$(id -u feclora-kiosk)"; for attempt in {1..30}; do if compgen -G "/run/user/${uid}/wayland-*" >/dev/null; then /usr/bin/chvt 1; exit 0; fi; sleep 1; done; echo "WARNING: Cage did not create a Wayland socket within 30 seconds; leaving the current VT active." >&2; exit 0'
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=::1/128
ReadWritePaths=/var/lib/feclora-kiosk /var/log/feclora-kiosk

[Install]
WantedBy=graphical.target
