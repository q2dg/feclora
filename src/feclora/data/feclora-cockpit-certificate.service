[Unit]
Description=Provision and trust the local Feclora Cockpit TLS certificate
After=local-fs.target
Before=cockpit.socket feclora-kiosk.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/feclora/feclora-cockpit-certificate
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
