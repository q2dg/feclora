#!/bin/sh
set -eu

CHANNEL=/dev/virtio-ports/org.feclora.boot-smoke
READY=/run/feclora-gtk/ready
attempts=0

while [ ! -f "$READY" ]; do
  if [ "$attempts" -ge 120 ]; then
    echo "GTK did not render its initial window." >&2
    exit 1
  fi
  sleep 0.25
  attempts=$((attempts + 1))
done

if [ -c "$CHANNEL" ] && [ -w "$CHANNEL" ]; then
  printf 'FECLORA_BOOT_SMOKE rendered\n' > "$CHANNEL"
fi
