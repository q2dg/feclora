#!/bin/sh
set -eu

CHANNEL=/dev/virtio-ports/org.feclora.boot-smoke
READY=/run/feclora-gtk/ready

# On physical appliances there is no QEMU virtio channel; do not delay boot
# waiting for a test-only signal that nobody can consume.
if [ ! -c "$CHANNEL" ] || [ ! -w "$CHANNEL" ]; then
  exit 0
fi

attempts=0
while [ ! -f "$READY" ]; do
  if [ "$attempts" -ge 120 ]; then
    echo "GTK did not paint its initial window." >&2
    exit 1
  fi
  sleep 0.25
  attempts=$((attempts + 1))
done

printf 'FECLORA_BOOT_SMOKE gtk-rendered\n' > "$CHANNEL"
