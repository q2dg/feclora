#!/usr/bin/bash
set -Eeuo pipefail

LOG_DIR=/var/log/feclora-kiosk
URL=http://127.0.0.1:9090/cockpit/@localhost/feclora/index.html
mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/launcher.log") 2>&1

log() {
  printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*"
}

smoke_event() {
  local port=/dev/virtio-ports/org.feclora.boot-smoke
  if [[ -w "$port" ]]; then
    if ! printf 'FECLORA_BOOT_SMOKE %s\n' "$1" > "$port"; then
      log "WARNING: QEMU boot-smoke status could not be sent."
    fi
  fi
}

UNAVAILABLE_FILE=/run/feclora-kiosk/cockpit-unavailable

preflight() {
  rm -f "$UNAVAILABLE_FILE"
  log "Restoring the Plymouth splash before checking Cockpit."
  if ! /usr/bin/plymouth --ping; then
    log "Plymouth is not running; restarting its boot service."
    if ! /usr/bin/systemctl restart plymouth-start.service; then
      log "WARNING: Plymouth boot service could not be restarted."
    fi
  fi
  if ! /usr/bin/plymouth activate; then
    log "WARNING: Plymouth could not be activated."
  fi

  local status=000
  for attempt in {1..15}; do
    if status=$(/usr/bin/curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 1 "$URL"); then
      if [[ "$status" == 200 ]]; then
        log "Feclora Cockpit page returned HTTP 200."
        smoke_event cockpit-ready
        if ! /usr/bin/plymouth deactivate; then
          log "WARNING: Plymouth could not release the display for Weston."
        fi
        return 0
      fi
    else
      status=000
    fi
    log "Cockpit readiness attempt $attempt/15 returned HTTP $status."
    smoke_event "http-$status"
    sleep 1
  done

  log "WARNING: Feclora Cockpit did not return HTTP 200; starting the local diagnostic screen instead: $URL"
  /usr/bin/systemctl --no-pager --full status feclora-cockpit-kiosk.service || true
  printf '%s\n' "$status" >"$UNAVAILABLE_FILE"
  chmod 0644 "$UNAVAILABLE_FILE"
  if ! /usr/bin/plymouth deactivate; then
    log "WARNING: Plymouth could not release the display for the diagnostic screen."
  fi
  smoke_event "fallback-http-$status"
  return 0
}

handoff() {
  local wayland_ready=0
  local firefox_ready=0
  local http_status

  for attempt in {1..30}; do
    wayland_ready=0
    firefox_ready=0
    if compgen -G '/run/feclora-kiosk/wayland-*' >/dev/null; then
      wayland_ready=1
    fi
    if /usr/bin/pgrep -u feclora-kiosk -x firefox >/dev/null; then
      firefox_ready=1
    fi
    if (( wayland_ready && firefox_ready )); then
      sleep 2
      if /usr/bin/pgrep -u feclora-kiosk -x firefox >/dev/null; then
        if ! /usr/bin/plymouth quit --retain-splash; then
          log "WARNING: Firefox is ready, but Plymouth could not finish the splash handoff."
        fi
        log "Weston and Firefox are ready; Plymouth handoff completed."
        /usr/libexec/feclora/feclora-kiosk-diagnostics post-start
        if [[ -r "$UNAVAILABLE_FILE" ]]; then
          http_status="$(<"$UNAVAILABLE_FILE")"
          log "The local diagnostic screen is visible; Cockpit last returned HTTP $http_status."
          smoke_event "fallback-ready-http-$http_status"
        else
          smoke_event ready
        fi
        return 0
      fi
      firefox_ready=0
    fi
    sleep 1
  done

  log "ERROR: Display handoff timed out (Wayland ready=$wayland_ready, Firefox ready=$firefox_ready); retaining Plymouth and restarting the kiosk."
  smoke_event handoff-timeout
  /usr/libexec/feclora/feclora-kiosk-diagnostics post-start
  return 1
}

case "${1:-}" in
  preflight) preflight ;;
  handoff) handoff ;;
  *) log "ERROR: Expected 'preflight' or 'handoff'."; exit 2 ;;
esac
