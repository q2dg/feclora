#!/usr/bin/bash
set -u

LOG_DIR=/var/log/feclora-kiosk
mkdir -p "$LOG_DIR"
chgrp feclora-logs "$LOG_DIR"
chmod 2750 "$LOG_DIR"
REPORT="$LOG_DIR/diagnostics.txt"
STAMP="$(date --iso-8601=seconds 2>/dev/null || date)"
TMP="$REPORT.tmp"

{
  echo "Feclora kiosk boot diagnostics"
  echo "Captured: $STAMP"
  echo "Trigger: ${1:-manual}"
  echo
  section() { printf '\n===== %s =====\n' "$1"; }
  section "BOOT AND KERNEL"
  printf 'cmdline: '; cat /proc/cmdline 2>&1 || true
  printf '\n'; uname -a 2>&1 || true
  printf '\n'; cat /etc/fedora-release 2>&1 || true

  section "COCKPIT EXECUTABLE PERMISSIONS AND SELINUX"
  ls -lZ /usr/libexec/cockpit-ws /usr/libexec/cockpit-bridge 2>&1 || true
  namei -l /usr/libexec/cockpit-ws 2>&1 || true
  stat /usr/libexec/cockpit-ws /usr/libexec/cockpit-bridge 2>&1 || true
  matchpathcon /usr/libexec/cockpit-ws /usr/libexec/cockpit-bridge 2>&1 || true
  getenforce 2>&1 || true
  ausearch -m AVC,USER_AVC -ts boot 2>&1 || true

  section "KIOSK AND COCKPIT UNIT STATUS"
  systemctl --no-pager --full status feclora-kiosk.service feclora-cockpit-kiosk.service systemd-logind.service 2>&1 || true
  systemctl show feclora-kiosk.service -p ActiveState -p SubState -p Result -p ExecMainCode -p ExecMainStatus -p NRestarts 2>&1 || true
  systemctl show feclora-cockpit-kiosk.service -p ActiveState -p SubState -p Result -p ExecMainCode -p ExecMainStatus 2>&1 || true

  section "RELEVANT JOURNAL"
  journalctl --boot --no-pager -o short-monotonic -u feclora-kiosk.service -u feclora-cockpit-kiosk.service -u systemd-logind.service 2>&1 || true

  section "KERNEL WARNINGS AND ERRORS"
  journalctl --boot --no-pager -o short-monotonic -k -p warning 2>&1 || true

  section "GRAPHICS DEVICES"
  ls -la /dev/dri /dev/fb* 2>&1 || true
  for f in /sys/class/drm/*/status /sys/class/drm/*/enabled /sys/class/graphics/fb*/name; do
    [ -e "$f" ] || continue
    echo "--- $f"; cat "$f" 2>&1 || true
  done
  cat /proc/fb 2>&1 || true
  lspci -nnk 2>&1 || true

  section "SEAT AND VIRTUAL TERMINALS"
  loginctl seat-status seat0 2>&1 || true
  loginctl list-sessions 2>&1 || true
  fgconsole 2>&1 || true
  chvt --help >/dev/null 2>&1 || true
  ls -la /dev/tty0 /dev/tty1 /dev/tty2 2>&1 || true

  section "WAYLAND AND PROCESSES"
  ls -la /run/feclora-kiosk 2>&1 || true
  ps -eo pid,ppid,user,stat,tty,comm,args 2>&1 | grep -E '(^ *PID|cage|firefox|Xwayland|cockpit-ws)' || true
  lsmod 2>&1 || true

  section "KIOSK LAUNCHER LOG"
  cat "$LOG_DIR/launcher.log" 2>&1 || true
} >"$TMP" 2>&1

mv -f "$TMP" "$REPORT"
chgrp feclora-logs "$REPORT"
chmod 0640 "$REPORT"

# The launcher runs with a restrictive systemd umask; normalize its log before archiving.
chgrp feclora-logs "$LOG_DIR/launcher.log" 2>/dev/null || true
chmod 0640 "$LOG_DIR/launcher.log" 2>/dev/null || true

# Keep a portable bundle containing only the kiosk-specific logs and report.
tar -czf "$LOG_DIR/diagnostics.tar.gz" -C "$LOG_DIR" diagnostics.txt launcher.log 2>/dev/null || true
chgrp feclora-logs "$LOG_DIR/diagnostics.tar.gz" 2>/dev/null || true
chmod 0640 "$LOG_DIR/diagnostics.tar.gz" 2>/dev/null || true
# Also copy the bundle to a writable boot partition when one is available;
# this can make the report recoverable from the VM disk without booting Feclora.
for boot_dir in /boot /boot/efi; do
  [ -d "$boot_dir" ] || continue
  probe="$boot_dir/.feclora-diagnostics-write-test"
  if : >"$probe" 2>/dev/null; then
    rm -f "$probe"
    cp -f "$LOG_DIR/diagnostics.txt" "$boot_dir/feclora-kiosk-diagnostics.txt" 2>/dev/null || true
    cp -f "$LOG_DIR/diagnostics.tar.gz" "$boot_dir/feclora-kiosk-diagnostics.tar.gz" 2>/dev/null || true
  fi
done
echo "Feclora diagnostics written to $REPORT"
