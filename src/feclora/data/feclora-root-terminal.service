[Unit]
Description=Feclora local root shell on tty2
After=systemd-logind.service kmsconvt@tty2.service
Conflicts=getty@tty2.service kmsconvt@tty2.service

[Service]
Type=idle
User=root
Group=root
TTYPath=/dev/tty2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/bash --login
ExecStopPost=+/usr/bin/chvt 1
Restart=no
UMask=0077

[Install]
WantedBy=multi-user.target
