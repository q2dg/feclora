[Unit]
Description=Loopback-only Feclora first-boot administrator setup
After=local-fs.target
Before=feclora-kiosk.service

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/usr/share/feclora/python
ExecStart=/usr/bin/python3 -m feclora.kiosk_bootstrap
ExecStartPost=/usr/libexec/feclora/feclora-kiosk-bootstrap-ready
TimeoutStartSec=35
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/feclora /etc/shadow /etc/shadow- /etc/.pwd.lock

[Install]
WantedBy=multi-user.target
