[Unit]
Description=Feclora root-authorized single-use unattended disk restore
ConditionPathExists=/etc/feclora/restore-profile.env
After=local-fs.target
RequiresMountsFor=/mnt/restore-media
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/feclora/restore-profile.env
ExecStart=/usr/local/bin/feclora-restore-profile
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
