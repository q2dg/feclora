#!/usr/bin/bash
set -Eeuo pipefail
LOG_DIR=/var/log/feclora-kiosk
mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/launcher.log") 2>&1
url=http://127.0.0.1:9091/cockpit/@localhost/feclora/index.html
export HOME=/var/lib/feclora-kiosk
# systemd creates this directory before applying the service mount namespace.
# PAM still registers the logind session and creates /run/user/980 independently.
export XDG_RUNTIME_DIR=/run/feclora-kiosk
export MOZ_ENABLE_WAYLAND=1
echo
echo "===== Feclora kiosk launch: $(date --iso-8601=seconds) ====="
echo "uid=$(id) cmdline=$(cat /proc/cmdline)"
echo "seat=${XDG_SEAT:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"
echo "DRM devices:"
ls -la /dev/dri 2>&1 || true
echo "Input devices:"
ls -la /dev/input 2>&1 || true
# Cockpit is optional: keep the graphical session independently diagnosable.
ready=0
for attempt in {1..15}; do
  if (exec 3<>/dev/tcp/127.0.0.1/9091) 2>/dev/null; then
    exec 3>&-
    ready=1
    break
  fi
  sleep 1
done
if (( ready == 0 )); then
  echo "WARNING: Cockpit kiosk endpoint is not listening on 127.0.0.1:9091 after 15 seconds."
  echo "Starting Weston/Firefox anyway; the Cockpit page may show a connection error until Cockpit is repaired."
  systemctl --no-pager --full status feclora-cockpit-kiosk.service 2>&1 || true
else
  echo "Cockpit endpoint is ready."
fi
# --no-config prevents a system/user weston.ini from loading optional modules.
# XWayland is deliberately not requested; Firefox is a native Wayland client.
WESTON_ARGS=(--backend=drm-backend.so --shell=kiosk-shell.so --no-config)
# Force software rendering only on VirtualBox; physical machines autodetect.
virt_vendor="$(systemd-detect-virt --vm 2>/dev/null || true)"
if [[ "$virt_vendor" == "oracle" ]]; then
  WESTON_ARGS+=(--renderer=pixman)
  echo "VirtualBox detected; using Weston Pixman software renderer."
else
  echo "Virtualization vendor: ${virt_vendor:-none}; using Weston renderer autodetection."
fi
echo "Starting Weston kiosk-shell and Firefox (native Wayland; XWayland disabled)."
echo "Weston/Firefox exit status and stderr will be recorded below."
exec /usr/bin/weston "${WESTON_ARGS[@]}" -- /usr/bin/firefox --kiosk --new-instance "$url"
